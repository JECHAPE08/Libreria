<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema Bibliotecario</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Estilos generales */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f0f8ff 0%, #e6f7ff 100%);
            min-height: 100vh;
            color: #2c3e50;
            line-height: 1.6;
        }

        /* Botón de toggle con colores azules */
        #toggleBtn {
            position: fixed;
            top: 20px;
            left: 20px;
            z-index: 1001;
            background: linear-gradient(135deg, #1976d2 0%, #0d47a1 100%);
            color: white;
            border: none;
            border-radius: 12px;
            width: 60px;
            height: 60px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 6px 20px rgba(13, 71, 161, 0.3);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 5px;
        }

        #toggleBtn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(13, 71, 161, 0.4);
            background: linear-gradient(135deg, #1565c0 0%, #083c86 100%);
        }

        #toggleBtn:active {
            transform: translateY(1px);
            box-shadow: 0 4px 15px rgba(13, 71, 161, 0.3);
        }

        /* Líneas del icono de hamburguesa */
        .hamburger-line {
            height: 3px;
            width: 25px;
            background: white;
            border-radius: 3px;
            transition: all 0.3s ease;
        }

        /* Transformación a X cuando el menú está abierto */
        .sidebar.collapsed ~ #toggleBtn .hamburger-line:nth-child(1),
        .sidebar.show ~ #toggleBtn .hamburger-line:nth-child(1) {
            transform: translateY(8px) rotate(45deg);
        }

        .sidebar.collapsed ~ #toggleBtn .hamburger-line:nth-child(2),
        .sidebar.show ~ #toggleBtn .hamburger-line:nth-child(2) {
            opacity: 0;
        }

        .sidebar.collapsed ~ #toggleBtn .hamburger-line:nth-child(3),
        .sidebar.show ~ #toggleBtn .hamburger-line:nth-child(3) {
            transform: translateY(-8px) rotate(-45deg);
        }

        /* Efecto de pulso en el botón */
        @@keyframes pulse {
            0% { box-shadow: 0 0 0 0 rgba(25, 118, 210, 0.5); }
            70% { box-shadow: 0 0 0 12px rgba(25, 118, 210, 0); }
            100% { box-shadow: 0 0 0 0 rgba(25, 118, 210, 0); }
        }

        #toggleBtn.pulse {
            animation: pulse 2s infinite;
        }

        /* Sidebar con espaciado mejorado */
        .sidebar {
            height: 100vh;
            width: 260px;
            position: fixed;
            top: 0;
            left: -260px;
            background: linear-gradient(to bottom, #0d47a1 0%, #061c44 100%);
            overflow-x: hidden;
            transition: left 0.4s ease;
            z-index: 1000;
            box-shadow: 5px 0 30px rgba(0, 0, 0, 0.3);
            display: flex;
            flex-direction: column;
        }

        .sidebar::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%23ffffff' fill-opacity='0.1' fill-rule='evenodd'/%3E%3C/svg%3E");
            background-size: 100% 100%;
            opacity: 0.1;
        }

        /* Header del sidebar - Diseño mejorado y limpio */
        .sidebar-header {
            padding: 25px 20px 20px;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
            background: rgba(0, 0, 0, 0.1);
        }

        .sidebar-title {
            color: white;
            font-size: 20px;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
            position: relative;
            display: inline-block;
            padding: 0 10px 10px;
        }

        .sidebar-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 50px;
            height: 2px;
            background: #64b5f6;
            border-radius: 1px;
        }

        .sidebar-title i {
            margin-right: 10px;
            color: #bbdefb;
        }

        .sidebar-menu {
            flex: 1;
            padding: 20px 10px 10px;
        }

        .sidebar a {
            padding: 15px 20px;
            text-decoration: none;
            font-size: 16px;
            color: #ffffff;
            display: flex;
            align-items: center;
            transition: all 0.4s ease;
            border-left: 4px solid transparent;
            margin: 8px 5px;
            border-radius: 0 8px 8px 0;
            position: relative;
            overflow: hidden;
            font-weight: 500;
        }

        .sidebar a::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.7s ease;
        }

        .sidebar a:hover::before {
            left: 100%;
        }

        .sidebar a:hover {
            background: rgba(255, 255, 255, 0.15);
            border-left: 4px solid #64b5f6;
            padding-left: 22px;
            color: #ffffff;
            transform: translateX(3px);
        }

        .sidebar a i {
            margin-right: 15px;
            font-size: 20px;
            width: 22px;
            text-align: center;
            color: #bbdefb;
        }

        /* Botón de cerrar sesión en la parte inferior */
        .sidebar-footer {
            margin-top: auto;
            padding: 15px 10px;
            border-top: 1px solid rgba(255, 255, 255, 0.2);
        }

        .logout-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 12px;
            background: rgba(255, 255, 255, 0.1);
            color: white;
            text-decoration: none;
            border-radius: 6px;
            transition: all 0.3s ease;
            font-weight: 500;
            font-size: 15px;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .logout-btn:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }

        .logout-btn i {
            margin-right: 10px;
            font-size: 18px;
            color: #ff5252;
        }

        /* Estado colapsado para pantallas grandes */
        .sidebar.collapsed {
            left: 0;
        }

        /* Estado mostrado para pantallas pequeñas */
        .sidebar.show {
            left: 0;
        }

        /* Contenido principal */
        .main {
            padding: 30px;
            transition: all 0.4s ease;
            margin-left: 0;
            min-height: 100vh;
            background-color: #ffffff;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            border-left: 1px solid #e3f2fd;
        }

        .main.expanded {
            margin-left: 260px;
        }

        /* Media queries para diferentes tamaños de pantalla */
        @@media screen and (min-width: 769px) {
            .sidebar.collapsed ~ .main {
                margin-left: 260px;
                width: calc(100% - 260px);
            }

            .sidebar:not(.collapsed) ~ #toggleBtn {
                left: 20px;
            }

            .sidebar.collapsed ~ #toggleBtn {
                left: 230px;
            }

            /* Ocultar overlay en desktop */
            .overlay {
                display: none !important;
            }
        }

        @@media screen and (max-width: 768px) {
            .sidebar {
                width: 240px;
            }

            .sidebar-header {
                padding: 20px 15px 15px;
            }

            .sidebar.show ~ .main {
                margin-left: 0;
            }

            .sidebar.show {
                box-shadow: 5px 0 30px rgba(0, 0, 0, 0.4);
            }

            .sidebar.show ~ #toggleBtn {
                left: 200px;
                z-index: 1002;
            }

            .main {
                padding: 20px;
            }

            .main.expanded {
                margin-left: 240px;
            }
        }

        /* Efecto de overlay en móviles */
        .overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            z-index: 999;
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        .sidebar.show ~ .overlay {
            display: block;
            opacity: 1;
        }
    </style>
</head>
<body>
    <div id="sidebar" class="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-title">
                <i class="fas fa-book-reader"></i> Sistema Bibliotecario
            </div>
        </div>

        <div class="sidebar-menu">
            <a href="/Usuarios"><i class="fas fa-home"></i> Inicio</a>
            <a href="/Usuarios/Bibliotecas"><i class="fas fa-book"></i> Préstamos</a>
        </div>

        <div class="sidebar-footer">
            <a href="/Login/Logout" class="logout-btn">
                <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
            </a>
        </div>
    </div>

    <button id="toggleBtn" aria-label="Toggle Menu">
        <div class="hamburger-line"></div>
        <div class="hamburger-line"></div>
        <div class="hamburger-line"></div>
    </button>

    <div class="overlay"></div>

    <div id="mainContent" class="main">
        @RenderBody()
    </div>

    <script>
        const toggleBtn = document.getElementById('toggleBtn');
        const sidebar = document.getElementById('sidebar');
        const mainContent = document.getElementById('mainContent');
        const overlay = document.querySelector('.overlay');

        // Añadir efecto de pulso al botón
        toggleBtn.classList.add('pulse');

        // Quitar el pulso después de 6 segundos
        setTimeout(() => {
            toggleBtn.classList.remove('pulse');
        }, 6000);

        // Función para cerrar el menú en móviles
        function closeSidebar() {
            if (window.innerWidth <= 768) {
                sidebar.classList.remove('show');
            }
        }

        toggleBtn.addEventListener('click', (e) => {
            e.stopPropagation(); // Evitar que el clic se propague al documento

            // Para pantallas grandes
            if (window.innerWidth > 768) {
                sidebar.classList.toggle('collapsed');
                mainContent.classList.toggle('expanded');
            } else {
                // Para pantallas pequeñas
                sidebar.classList.toggle('show');
            }

            // Añadir efecto de pulso al interactuar
            toggleBtn.classList.remove('pulse');
            void toggleBtn.offsetWidth; // Reiniciar animación
            toggleBtn.classList.add('pulse');

            // Quitar el pulso después de un tiempo
            setTimeout(() => {
                toggleBtn.classList.remove('pulse');
            }, 2000);
        });

        // Cerrar menú al hacer clic en el overlay
        overlay.addEventListener('click', closeSidebar);

        // Cerrar menú al hacer clic fuera en dispositivos móviles
        document.addEventListener('click', (e) => {
            // Si el menú está abierto en móvil y se hace clic fuera de él
            if (window.innerWidth <= 768 &&
                sidebar.classList.contains('show') &&
                !sidebar.contains(e.target) &&
                e.target !== toggleBtn) {
                closeSidebar();
            }
        });

        // Evitar que los clics dentro del menú cierren el menú
        sidebar.addEventListener('click', (e) => {
            e.stopPropagation();
        });

        // Opcional: cerrar sidebar si se redimensiona
        window.addEventListener('resize', () => {
            if (window.innerWidth > 768) {
                sidebar.classList.remove('show');
                overlay.style.display = 'none';
            } else {
                sidebar.classList.remove('collapsed');
                mainContent.classList.remove('expanded');
            }
        });
    </script>
</body>
</html>